      </CL_SSF_FB_TABLE_ROW>
    </cls:CL_SSF_FB_TABLE_ROW>

    <!-- Condition for TBL_BODY (always active) -->
    <cls:CL_SSF_FB_CONDITION id="o13">
      <CL_SSF_FB_CONDITION classVersion="1">
        <NODE href="#o12"/>
        <CONDITIONS/>
      </CL_SSF_FB_CONDITION>
    </cls:CL_SSF_FB_CONDITION>

  </asx:heap>

</asx:abap>
